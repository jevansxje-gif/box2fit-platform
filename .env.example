# Box2Fit Platform — environment config. Copy to .env; never commit .env.

SECRET_KEY=change-me
SITE_BASE_URL=http://localhost:5001
FLASK_ENV=development

# MariaDB in staging/prod; omit for local SQLite dev fallback
# DATABASE_URL=mysql+pymysql://box2fit:password@localhost:3306/box2fit_platform

REDIS_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# Stripe — TEST MODE until told otherwise
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email — SMTP (Brevo etc.) preferred; SendGrid supported as fallback
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=hello@box2fit.com
MAIL_FROM_NAME=Box2Fit White Rock
# Staff mailbox that gets "new sign-up" alerts (empty = off)
ADMIN_NOTIFY_EMAIL=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@box2fit.com
SENDGRID_FROM_NAME=Box2Fit White Rock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

JWT_SECRET=change-me-too
JWT_EXPIRES_MINUTES=43200

SENTRY_DSN=

# --- Booking policy (RSVP model; all cutoffs default OFF per resolved policy) ---
# Minutes before class start when booking closes. 0 = open until start.
POLICY_BOOKING_CUTOFF_MIN=0
# Minutes before class start when cancelling closes. 0 = cancel anytime.
POLICY_CANCEL_CUTOFF_MIN=0
# Hours before start under which a cancel counts as "late" (silent, staff-only).
POLICY_LATE_CANCEL_HOURS=12
# Minutes after class end when unmarked bookings auto-flag as no-show.
POLICY_NOSHOW_AUTOMARK_MIN=30
# Waitlist promotion confirm-or-release window (hours).
POLICY_WAITLIST_CONFIRM_HOURS=2
# Members book only their own group's classes (0 = locked to their group).
POLICY_ALLOW_CROSS_GROUP=0

# Schedule generation horizon (weeks ahead)
SCHEDULE_HORIZON_WEEKS=4
